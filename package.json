{
  "name": "argus-workbench",
  "version": "0.29.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Development tooling for the Argus vanilla JavaScript frontend; no Node runtime is needed in production.",
  "scripts": {
    "lint": "eslint static --max-warnings 0",
    "format": "prettier --write static",
    "format:check": "prettier --check static",
    "test:frontend": "node --test tests/test_frontend_uuid.cjs",
    "build": "node scripts/build_frontend.mjs",
    "build:check": "node scripts/build_frontend.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "esbuild": "0.25.10"
  },
  "license": "MIT"
}
