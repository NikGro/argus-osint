{
  "name": "argus-workbench",
  "version": "26.10.1-beta.1",
  "private": true,
  "type": "module",
  "description": "Development tooling for the ARGUS React frontend; no Node runtime is needed in production.",
  "scripts": {
    "lint": "eslint static --max-warnings 0",
    "format": "prettier --write static",
    "format:check": "prettier --check static",
    "test:frontend": "node --test tests/test_frontend_uuid.cjs",
    "build": "node scripts/build_frontend.mjs",
    "build:check": "node scripts/build_frontend.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "license": "MIT",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
